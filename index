</style></head><body><div class="screen"><header><div class="brand"><div class="brandmark">⚙</div><div><h1>TECHNICKÉ ODDĚLENÍ</h1><div class="subtitle">FALKENSTEINER · MARIÁNSKÉ LÁZNĚ</div></div></div><div class="hotelPhoto"><img src="https://image-tc.galaxy.tf/wijpeg-82m9hxoqhf6de9icgzi3nvua8/2106ja-falkensteiner-marienbad-architektur-4333-2.jpg?width=1920" alt="Falkensteiner Spa Resort Mariánské Lázně – hotel a venkovní bazén" referrerpolicy="no-referrer"><div class="photoLabel">FALKENSTEINER SPA RESORT</div></div><div class="time"><div class="clock" id="clock">--:--:--</div><div class="date" id="date">—</div></div></header><main class="dashboard"><section class="card duty"><div class="label"><span class="dot"></span> POHOTOVOST · TENTO TÝDEN</div><div class="name" id="duty">—</div><div class="range" id="range">—</div><div class="next">Příští týden: <strong id="next">—</strong></div></section><section class="card"><div class="label"><span class="dot"></span> POČASÍ · MARIÁNSKÉ LÁZNĚ</div><div class="weatherTop"><div class="weatherIcon" id="weatherIcon">🌤️</div><div><div class="weatherTemp" id="weather">—°</div><div class="weatherDesc" id="weatherDesc">Načítání počasí…</div></div></div><div class="weatherMeta"><span>Pocitově <strong id="feels">—</strong></span><span>Vítr <strong id="wind">—</strong></span></div></section><section class="card pools"><div class="label"><span class="dot"></span> AKTUÁLNÍ TEPLOTY BAZÉNŮ</div><div class="poolgrid"><div class="pool"><div class="poolIcon">♨️</div><div class="poolname">WHIRLPOOL</div><div class="pooltemp" id="whirlpool">— °C</div></div><div class="pool"><div class="poolIcon">🌊</div><div class="poolname">AKTIV-POOL</div><div class="pooltemp" id="aktivpool">— °C</div></div><div class="pool"><div class="poolIcon">💧</div><div class="poolname">SOLEPOOL</div><div class="pooltemp" id="solepool">— °C</div></div><div class="pool"><div class="poolIcon">🏊</div><div class="poolname">OUTDOOR-POOL</div><div class="pooltemp" id="outdoorpool">— °C</div></div></div><div class="poolstatus" id="poolstatus">Čekám na data z hotelové sítě…</div></section><section class="card news"><div class="newsHeader"><div class="label"><span class="dot"></span> AKTUÁLNÍ ZPRÁVY</div><div class="newsPager"><span id="newsUpdated">Obnovování každých 15 minut</span><span id="pageNumber">1/1</span><span class="pageTrack"><span class="pageFill" id="pageFill" style="display:block"></span></span></div></div><div class="newsColumns"><div class="newsCol"><div class="sourceTitle">ČT24</div><div id="news1" class="headlines"><div class="newsError">Načítání zpráv…</div></div></div><div class="newsCol"><div class="sourceTitle">NOVINKY.CZ</div><div id="news2" class="headlines"><div class="newsError">Načítání zpráv…</div></div></div></div></section></main><footer class="footer"><span>● INFORMAČNÍ PANEL TECHNICKÉHO ODDĚLENÍ</span><span id="updated">Automatická aktualizace dat</span></footer></div><script>
'use strict';const $=id=>document.getElementById(id);const names=['Vašek','Michal','Jarek','David'];const tz='Europe/Prague';function formatDate(d){return d.toLocaleDateString('cs-CZ',{timeZone:tz,day:'numeric',month:'numeric',year:'numeric'})}function clock(){const d=new Date();$('clock').textContent=d.toLocaleTimeString('cs-CZ',{timeZone:tz,hour12:false});$('date').textContent=d.toLocaleDateString('cs-CZ',{timeZone:tz,weekday:'long',day:'numeric',month:'long',year:'numeric'});const parts=new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(d);const p=Object.fromEntries(parts.map(x=>[x.type,x.value]));const today=Date.UTC(+p.year,+p.month-1,+p.day);const base=Date.UTC(2026,10,2);const weeks=Math.floor((today-base)/604800000);const idx=((weeks%4)+4)%4;const mon=new Date(base+weeks*604800000),sun=new Date(base+(weeks*7+6)*86400000);$('duty').textContent=names[idx].toUpperCase();$('range').textContent=formatDate(mon)+' – '+formatDate(sun);$('next').textContent=names[(idx+1)%4]}clock();setInterval(clock,1000);
function weatherInfo(c){if(c===0)return ['☀️','Jasno'];if(c<=3)return ['⛅','Polojasno / oblačno'];if(c<=48)return ['🌫️','Mlha'];if(c<=57)return ['🌦️','Mrholení'];if(c<=67)return ['🌧️','Déšť'];if(c<=77)return ['❄️','Sněžení'];if(c<=82)return ['🌦️','Přeháňky'];if(c<=86)return ['🌨️','Sněhové přeháňky'];if(c>=95)return ['⛈️','Bouřky'];return ['🌤️','Proměnlivé počasí']}async function weather(){try{const u='https://api.open-meteo.com/v1/forecast?latitude=49.9646&longitude=12.7010&current=temperature_2m,apparent_temperature,wind_speed_10m,weather_code&timezone=Europe%2FPrague';const r=await fetch(u,{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);const c=(await r.json()).current;const [icon,desc]=weatherInfo(c.weather_code);$('weatherIcon').textContent=icon;$('weather').textContent=Math.round(c.temperature_2m)+'°';$('weatherDesc').textContent=desc;$('feels').textContent=Math.round(c.apparent_temperature)+' °C';$('wind').textContent=Math.round(c.wind_speed_10m)+' km/h'}catch(e){$('weatherDesc').textContent='Počasí momentálně nedostupné'}}weather();setInterval(weather,900000);
const poolIds={1:'solepool',2:'aktivpool',3:'whirlpool',4:'outdoorpool'};async function pools(){try{const r=await fetch('/BeckhoffService.asmx/GetPoolObjectData',{method:'POST',headers:{'Content-Type':'application/json; charset=utf-8'},body:JSON.stringify({FromDatabase:true}),cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);const json=await r.json();let data=json.d;if(typeof data==='string')data=JSON.parse(data);if(!Array.isArray(data))throw Error('Neplatná odpověď');let count=0;for(const item of data){const match=String(item.varuiid||'').match(/TEMPERATURESENSORRETURNFLOWHC\[(\d+)\]\.STATE\.LRACTSENSORVALUEFILTERED$/i);if(match&&poolIds[+match[1]]){const value=Number(String(item.varvalue).replace(',','.'));if(Number.isFinite(value)){$(poolIds[+match[1]]).textContent=value.toLocaleString('cs-CZ',{minimumFractionDigits:1,maximumFractionDigits:1})+' °C';count++}}}if(!count)throw Error('Senzory nenalezeny');$('poolstatus').textContent='● Teploty aktualizovány v '+new Date().toLocaleTimeString('cs-CZ',{timeZone:tz});$('poolstatus').className='poolstatus statusOk'}catch(e){$('poolstatus').textContent='● Bazény: připojení vyžaduje hotelový server nebo interní proxy';$('poolstatus').className='poolstatus statusError'}}pools();setInterval(pools,60000);
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
const newsStore={news1:[],news2:[]};let newsPage=0;const ITEMS_PER_PAGE=3;
function renderNews(){let total=Math.max(1,...Object.values(newsStore).map(a=>Math.ceil(a.length/ITEMS_PER_PAGE)));newsPage%=total;
 for(const id of ['news1','news2']){const items=newsStore[id];if(!items.length)continue;let localPage=newsPage%Math.ceil(items.length/ITEMS_PER_PAGE);$(id).innerHTML=items.slice(localPage*ITEMS_PER_PAGE,(localPage+1)*ITEMS_PER_PAGE).map(x=>'<div class="headline">'+escapeHtml(x.title)+'</div>').join('')}
 $('pageNumber').textContent=(newsPage+1)+'/'+total;$('pageFill').style.width=((newsPage+1)/total*100)+'%';}
async function feed(url,id){try{const endpoint='https://api.rss2json.com/v1/api.json?rss_url='+encodeURIComponent(url);const r=await fetch(endpoint,{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);const j=await r.json();if(j.status!=='ok'||!Array.isArray(j.items)||!j.items.length)throw Error('Prázdný RSS kanál');newsStore[id]=j.items.slice(0,12).filter(x=>x.title);return true}catch(e){if(!newsStore[id].length)$(id).innerHTML='<div class="newsError">Zprávy se nepodařilo načíst. RSS služba může být dočasně nedostupná.</div>';return false}}
async function news(){const results=await Promise.all([feed('https://ct24.ceskatelevize.cz/rss/hlavni-zpravy','news1'),feed('https://www.novinky.cz/rss','news2')]);newsPage=0;renderNews();$('newsUpdated').textContent=results.some(Boolean)?'Zprávy se střídají po 12 s · '+new Date().toLocaleTimeString('cs-CZ',{timeZone:tz}):'Zdroj zpráv nedostupný';$('updated').textContent='Automatická aktualizace · '+new Date().toLocaleTimeString('cs-CZ',{timeZone:tz})}
news();setInterval(news,900000);setInterval(()=>{newsPage++;renderNews()},12000);
</script></body></html>
