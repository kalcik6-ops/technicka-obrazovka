.hotelPhoto img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 56%}
.hotelPhoto:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#07132022,transparent 45%,#07132033);pointer-events:none}
.hotelPhoto .photoLabel{position:absolute;bottom:8px;left:10px;z-index:1;background:#071320bb;border:1px solid #ffffff40;border-radius:7px;padding:5px 9px;font-size:clamp(9px,.72vw,14px);font-weight:700;letter-spacing:.07em}
.brand{flex:1;min-width:0}.time{flex:none}
