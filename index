n:column;flex:1;min-height:0;justify-content:space-evenly}.headline{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;font-size:clamp(12px,1.17vw,23px);line-height:1.3;font-weight:600;padding:.65vh 0;border-bottom:1px solid #2b4255}.headline:last-child{border:0}.newsPager{display:flex;align-items:center;gap:9px;font-size:clamp(10px,.85vw,17px);color:#9cb9c9}.pageTrack{width:62px;height:4px;border-radius:8px;background:#355168;overflow:hidden}.pageFill{height:100%;width:0;background:#60d9f3;transition:width .3s}.headline{animation:fadeNews .45s ease both}@keyframes fadeNews{from{opacity:.15;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}.newsError{font-size:clamp(12px,1.1vw,22px);color:#c1d3df;line-height:1.5}.footer{display:flex;justify-content:space-between;color:#88a8ba;font-size:clamp(10px,.8vw,16px);gap:12px}.statusOk{color:var(--green)}.statusError{color:#ffc28b}@media(max-aspect-ratio:1/1){.dashboard{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr 1.3fr}.pools{grid-column:2;grid-row:1/3}.news{grid-column:1/3;grid-row:3}.weatherTop{gap:5px}.weatherIcon{font-size:7vw}.weatherTemp{font-size:7vw}}@media(max-height:650px){.screen{padding:9px 15px;gap:7px}.card{padding:10px 15px}.brandmark{width:32px;border-radius:9px}.poolgrid{margin-top:7px}.pool{padding:8px 12px}.weatherMeta{padding-top:6px}.headline{padding:2px 0}}

/* Hotelová fotografie v hlavičce – bez změny velikosti TV panelů */
